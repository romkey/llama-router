# llama-router configuration. Copy to .env and uncomment what you need; every
# variable is optional and shows its default. Meanings: docs/configuration.md.
# The values here are dummies; never commit a real .env.

# Timezone for dashboard timestamps.
# TZ=America/New_York

# docker-compose.prod.yaml: image tag to run.
# APP_VERSION=latest

# --- Database ---------------------------------------------------------------
# SQLite file used when DATABASE_URL is empty. The Docker image sets
# /app/data/llama_router.db.
# LLAMA_ROUTER_DATABASE_PATH=llama_router.db
# Async SQLAlchemy URL; overrides DATABASE_PATH. The Docker image includes the
# PostgreSQL and MySQL drivers; a pip or uv install needs the postgres or
# mysql extra:
#   postgresql+asyncpg://user:pass@host/dbname
#   mysql+asyncmy://user:pass@host/dbname
# LLAMA_ROUTER_DATABASE_URL=postgresql+asyncpg://llama:change-me@db/llama_router
# Copy SQLite to PostgreSQL (in the Docker image, or after
# pip install 'llama-router[postgres]'):
#   llama-router-migrate-sqlite-pg --sqlite llama_router.db --postgres postgresql+psycopg://...

# --- Servers ----------------------------------------------------------------
# LLAMA_ROUTER_DASHBOARD_HOST=0.0.0.0
# LLAMA_ROUTER_DASHBOARD_PORT=80
# LLAMA_ROUTER_API_HOST=0.0.0.0
# LLAMA_ROUTER_API_PORT=11434
# LLAMA_ROUTER_LLAMACPP_HOST=0.0.0.0
# LLAMA_ROUTER_LLAMACPP_PORT=8080
# Also serve the Ollama/OpenAI APIs and worker links on the dashboard port.
# Require API keys before exposing it.
# LLAMA_ROUTER_API_ON_DASHBOARD_PORT=false
# Prometheus metrics at GET /metrics on the dashboard port. Scrapers send the
# token as Authorization: Bearer; without one a dashboard sign-in is needed.
# LLAMA_ROUTER_METRICS_ENABLED=true
# LLAMA_ROUTER_METRICS_TOKEN=change-me

# --- Dashboard sign-in ------------------------------------------------------
# Signs session cookies. Empty: a random secret is kept in the database.
# LLAMA_ROUTER_SESSION_SECRET=change-me-to-a-long-random-string
# Set true when the dashboard is served only over HTTPS.
# LLAMA_ROUTER_DASHBOARD_COOKIE_SECURE=false
# OpenID Connect single sign-on. An empty issuer turns it off.
# LLAMA_ROUTER_OIDC_ISSUER=https://auth.example.org/realms/main
# LLAMA_ROUTER_OIDC_CLIENT_ID=llama-router
# LLAMA_ROUTER_OIDC_CLIENT_SECRET=change-me
# LLAMA_ROUTER_OIDC_SCOPES=openid profile email groups
# LLAMA_ROUTER_OIDC_GROUPS_CLAIM=groups
# LLAMA_ROUTER_OIDC_ADMIN_GROUP=llm-admins
# LLAMA_ROUTER_OIDC_ALLOWED_GROUP=llm-users
# LLAMA_ROUTER_OIDC_REDIRECT_BASE_URL=https://llm.example.org
# LLAMA_ROUTER_OIDC_DISPLAY_NAME=single sign-on
# LLAMA_ROUTER_OIDC_ONLY=false
# LLAMA_ROUTER_OIDC_LOGOUT_AT_IDP=false
# LLAMA_ROUTER_OIDC_ALLOW_INSECURE=false

# --- Providers and routing --------------------------------------------------
# LLAMA_ROUTER_HEALTH_CHECK_INTERVAL_SECONDS=30
# LLAMA_ROUTER_QUIET_HEALTH_CHECKS=false
# LLAMA_ROUTER_AUTO_PROBE_ENABLED=true
# LLAMA_ROUTER_PROBE_MAX_AGE_HOURS=24
# LLAMA_ROUTER_OLLAMA_API_TRANSLATION=true
# LLAMA_ROUTER_SESSION_AFFINITY_ENABLED=true
# LLAMA_ROUTER_SESSION_AFFINITY_TTL_SECONDS=1800
# LLAMA_ROUTER_SESSION_AFFINITY_MAX_SESSIONS=1000
# LLAMA_ROUTER_DECISION_POLICY_TIMEOUT_SECONDS=3.0

# --- Benchmarks -------------------------------------------------------------
# LLAMA_ROUTER_BENCHMARK_PROMPT=Write a short sentence about the weather.
# Dashboard values override these once saved.
# LLAMA_ROUTER_AUTO_BENCHMARK_ENABLED=true
# LLAMA_ROUTER_AUTO_BENCHMARK_IDLE_SECONDS=300
# LLAMA_ROUTER_AUTO_BENCHMARK_MAX_AGE_DAYS=7
# LLAMA_ROUTER_AUTO_BENCHMARK_CHECK_SECONDS=60
# LLAMA_ROUTER_AUTO_BENCHMARK_CONCURRENCY=1

# --- Ollama registry cache --------------------------------------------------
# LLAMA_ROUTER_CACHE_ENABLED=true
# The Docker image sets /app/data/model_cache.
# LLAMA_ROUTER_CACHE_DIR=./model_cache
# LLAMA_ROUTER_CACHE_HOST=0.0.0.0
# LLAMA_ROUTER_CACHE_PORT=9200
# Needed for remote Ollama backends: the IP or hostname they reach this host on.
# LLAMA_ROUTER_CACHE_EXTERNAL_HOST=192.168.1.50
# LLAMA_ROUTER_CACHE_MANIFEST_TTL_HOURS=240
# LLAMA_ROUTER_CACHE_MAX_CONCURRENT_BLOBS=4

# --- Hub and worker links (docs/workers.md) ---------------------------------
# LLAMA_ROUTER_WORKER_HUB_ENABLED=true
# Dial out to a hub. Setting both pins the link and locks the dashboard form.
# LLAMA_ROUTER_WORKER_HUB_URL=https://llm.example.org
# LLAMA_ROUTER_WORKER_TOKEN=lrw_dummy
# Local backends the worker relays jobs to. Empty uses this router's own APIs
# on 127.0.0.1; "none" turns that protocol off.
# LLAMA_ROUTER_WORKER_OLLAMA_URL=
# LLAMA_ROUTER_WORKER_LLAMACPP_URL=
# LLAMA_ROUTER_WORKER_UPSTREAM_API_KEY=
# LLAMA_ROUTER_WORKER_MAX_CONCURRENCY=4
# LLAMA_ROUTER_WORKER_ALLOW_ADMIN=false

# --- Cloud providers --------------------------------------------------------
# A provider is created at startup for each key that is set.
# LLAMA_ROUTER_PROVIDER_OPENAI_API_KEY=sk-dummy
# LLAMA_ROUTER_PROVIDER_OPENROUTER_API_KEY=sk-or-dummy
# LLAMA_ROUTER_PROVIDER_ANTHROPIC_API_KEY=
# LLAMA_ROUTER_PROVIDER_PERPLEXITY_API_KEY=
# LLAMA_ROUTER_PROVIDER_GROQ_API_KEY=
# LLAMA_ROUTER_PROVIDER_TOGETHER_API_KEY=
# LLAMA_ROUTER_PROVIDER_FIREWORKS_API_KEY=
# LLAMA_ROUTER_PROVIDER_DEEPSEEK_API_KEY=
# LLAMA_ROUTER_PROVIDER_MISTRAL_API_KEY=
# LLAMA_ROUTER_PROVIDER_GEMINI_API_KEY=
# LLAMA_ROUTER_PROVIDER_XAI_API_KEY=
# LLAMA_ROUTER_PROVIDER_CEREBRAS_API_KEY=
# LLAMA_ROUTER_PROVIDER_DEEPINFRA_API_KEY=
# LLAMA_ROUTER_PROVIDER_OLLAMA_CLOUD_API_KEY=
# LLAMA_ROUTER_PROVIDER_AZURE_OPENAI_API_KEY=
# LLAMA_ROUTER_PROVIDER_AZURE_OPENAI_RESOURCE=my-resource
# LLAMA_ROUTER_PROVIDER_TYPESAFE_API_KEY=

# --- Hugging Face downloads -------------------------------------------------
# The Docker image sets /app/data/hf_models.
# LLAMA_ROUTER_HF_MODELS_DIR=./hf_models
# The hf CLI reads these itself. Leave unused ones commented out: an empty
# HF_ENDPOINT breaks the client.
# HF_TOKEN=hf_dummy
# HF_ENDPOINT=https://hf-mirror.example.org
# HF_HOME=/app/data/hf
# HF_HUB_CACHE=
# HF_XET_CACHE=
# HF_DEBUG=1                 # logs requests as curl commands, token included
# HF_HUB_VERBOSITY=info      # debug, info, warning, error, critical
# HF_HUB_DOWNLOAD_TIMEOUT=10
# HF_HUB_ETAG_TIMEOUT=10
# HF_HUB_OFFLINE=1
# HF_HUB_DISABLE_TELEMETRY=1
# HF_HUB_DISABLE_XET=1
# HF_XET_HIGH_PERFORMANCE=1
# HF_HUB_DISABLE_SYMLINKS=1
# HTTP_PROXY=http://proxy.example:3128
# HTTPS_PROXY=http://proxy.example:3128
# NO_PROXY=localhost,127.0.0.1
# REQUESTS_CA_BUNDLE=/etc/ssl/certs/corp-ca.pem
# SSL_CERT_FILE=/etc/ssl/certs/corp-ca.pem
# Deprecated aliases the hf CLI still honors:
# HUGGING_FACE_HUB_TOKEN=
# HUGGINGFACE_HUB_CACHE=

# --- Sentry -----------------------------------------------------------------
# An empty DSN disables Sentry.
# LLAMA_ROUTER_SENTRY_DSN=https://key@o0.ingest.sentry.io/0
# LLAMA_ROUTER_SENTRY_ENVIRONMENT=production
# LLAMA_ROUTER_SENTRY_TRACES_SAMPLE_RATE=0.0
# LLAMA_ROUTER_SENTRY_PROFILES_SAMPLE_RATE=0.0
# LLAMA_ROUTER_SENTRY_SEND_DEFAULT_PII=false

# --- Tests ------------------------------------------------------------------
# Run database tests against a throwaway server; it is emptied before each test.
# LLAMA_ROUTER_TEST_DATABASE_URL=mysql+asyncmy://root:pw@127.0.0.1:3306/lr
