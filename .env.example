# llama-router configuration
# Copy to .env and edit as needed. All variables are optional — defaults shown.

# General
TZ=America/New_York

# Database
# Default: SQLite file at LLAMA_ROUTER_DATABASE_PATH (async URL is derived automatically).
LLAMA_ROUTER_DATABASE_PATH=llama_router.db
# Optional: full async SQLAlchemy URL (overrides DATABASE_PATH when set). Install extras for drivers:
#   pip install '.[postgres]'  → postgresql+asyncpg://user:pass@host/dbname
#   pip install '.[mysql]'     → mysql+asyncmy://user:pass@host/dbname
# LLAMA_ROUTER_DATABASE_URL=sqlite+aiosqlite:////absolute/path/to/llama_router.db
# Copy SQLite → Postgres (requires: pip install '.[postgres]'):
# llama-router-migrate-sqlite-pg --sqlite /path/to/llama_router.db --postgres postgresql+psycopg://user:pass@host/db

# Dashboard
LLAMA_ROUTER_DASHBOARD_HOST=0.0.0.0
LLAMA_ROUTER_DASHBOARD_PORT=80
# Secret for signing dashboard session cookies (recommended in production).
# If unset, a random secret is stored in the database on first use.
LLAMA_ROUTER_SESSION_SECRET=
# Set true when the dashboard is served only over HTTPS.
LLAMA_ROUTER_DASHBOARD_COOKIE_SECURE=false

# Ollama API
LLAMA_ROUTER_API_HOST=0.0.0.0
LLAMA_ROUTER_API_PORT=11434

# llama.cpp / OpenAI-compatible API
LLAMA_ROUTER_LLAMACPP_HOST=0.0.0.0
LLAMA_ROUTER_LLAMACPP_PORT=8080

# Health checks
LLAMA_ROUTER_HEALTH_CHECK_INTERVAL_SECONDS=30

# Benchmarking
LLAMA_ROUTER_BENCHMARK_PROMPT=Write a short sentence about the weather.

# OCI Registry Pull-Through Cache
LLAMA_ROUTER_CACHE_ENABLED=true
LLAMA_ROUTER_CACHE_DIR=./model_cache
LLAMA_ROUTER_CACHE_HOST=0.0.0.0
LLAMA_ROUTER_CACHE_PORT=9200
# Required for cache to work with remote Ollama backends — set to the
# IP or hostname that your Ollama backends can use to reach this machine
LLAMA_ROUTER_CACHE_EXTERNAL_HOST=
LLAMA_ROUTER_CACHE_MANIFEST_TTL_HOURS=240
# Maximum parallel blob downloads during dashboard model pre-caching
LLAMA_ROUTER_CACHE_MAX_CONCURRENT_BLOBS=4

# Sentry (optional)
# Set DSN to enable Sentry error/performance reporting
LLAMA_ROUTER_SENTRY_DSN=
LLAMA_ROUTER_SENTRY_ENVIRONMENT=production
LLAMA_ROUTER_SENTRY_TRACES_SAMPLE_RATE=0.0
LLAMA_ROUTER_SENTRY_PROFILES_SAMPLE_RATE=0.0
LLAMA_ROUTER_SENTRY_SEND_DEFAULT_PII=false

# WireGuard
# Path where wg0.conf is written (interface name = basename without .conf).
# LLAMA_ROUTER_WIREGUARD_CONFIG_PATH=/etc/wireguard/wg0.conf

# If true, only write the config file; do not run wg-quick/wg from the app.
# LLAMA_ROUTER_WIREGUARD_LEGACY_VOLUME=false

# If true, apply WireGuard when the process starts (requires wg-quick on PATH).
# LLAMA_ROUTER_WIREGUARD_ENABLED=false
